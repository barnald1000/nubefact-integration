{
    "name": "savia/nubefact-integration",
    "description": "Nubefact integration",
    "type": "library",
    "authors": [
        {
            "name": "Enea Dhack",
            "email": "enea@vaened.dev"
        }
    ],
    "autoload": {
        "psr-4": {
            "Savia\\NubeFactIntegration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Savia\\NubeFactIntegration\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "vaened/support": "^4.2",
        "lambdish/phunctional": "^2.1",
        "guzzlehttp/guzzle": "^7.0",
        "brick/money": "^0.15.2",
        "brick/math": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^7.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "lint": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --using-cache=yes",
        "lint:diff": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose --using-cache=yes",
        "lint:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=yes"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    }
}
